# Скопируйте в .env и при необходимости поменяйте значения. Файл .env в git не попадает.
APP_NAME="Sports Site API"
DEBUG=false

# Локальная база (см. README: «Настройка локальной БД»)
DATABASE_URL=postgresql+asyncpg://sports:sports@localhost:5432/sports_site
TEST_DATABASE_URL=postgresql+asyncpg://sports:sports@localhost:5432/sports_site_test

# Адреса фронтенда для CORS (JSON-список)
CORS_ORIGINS=["http://localhost:5173"]

# Секрет для подписи JWT (не короче 32 символов). Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
